<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            Booting the full Filament admin panel inside Livewire component
            tests (tests/Feature/AdminAuthorizationTest.php) walks past PHP's
            stock 128M. Raised here rather than in php.ini so CI, local XAMPP
            and `php artisan test` (which spawns its own PHP process and does
            NOT inherit a -d flag) all agree.
        -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            MySQL-only project — there is NO sqlite path (see CLAUDE.md).
            Tests run against a dedicated MySQL database that must exist:
            `temple_portal_test`. Locally: create it once with
            `mysql -uroot -e "CREATE DATABASE temple_portal_test"`.
            In CI a mysql:8 service container provides it (.github/workflows).
            DB_HOST / DB_PORT / DB_USERNAME / DB_PASSWORD fall through to the
            environment / .env so they can differ between local XAMPP and the
            CI container.
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="temple_portal_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
